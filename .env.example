# Domain name pointing to your server (needed for HTTPS).
DOMAIN=attendance.example.com

# First owner (developer) account, created on the very first start only.
# Leave the password empty to get a random one printed in the logs (docker compose logs app).
BOOTSTRAP_DEV_USERNAME=developer
BOOTSTRAP_DEV_PASSWORD=

# Used as the contact for map/address services and push notifications.
CONTACT_EMAIL=you@example.com

# Name shown in the app and on phones' home screens.
APP_NAME=OnSite

# Optional: another map tile provider (default: OpenStreetMap).
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
